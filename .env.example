# Copy to .env before first run:  cp .env.example .env
# Never commit the real .env.

# Signing key for session JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# API port. The Vite dev server proxies /api to this port.
PORT=8787

# SQLite database file (relative paths resolve from the project root).
DATABASE_FILE=./data/physics-lab.db

# Bootstrap administrator, created by `npm run db:seed` if no admin exists yet.
ADMIN_EMAIL=admin@physics.lab
ADMIN_PASSWORD=change-this-password

# Comma-separated origins allowed to call the API (dev default shown).
CORS_ORIGIN=http://localhost:5173

# In production, serve the built client from the API process.
SERVE_CLIENT=false

# ---------------------------------------------------------------- front end
# static (default): catalogue baked into the build, no server, free to host.
# server: talk to the Express + SQLite backend in server/.
VITE_DATA_MODE=static
# Opens the editor in the browser when in static mode. This is a convenience
# lock, not a security boundary: with no server there is nothing to protect.
VITE_ADMIN_PASSPHRASE=dynamis
